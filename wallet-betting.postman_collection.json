            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"data.type is deposit\", () => pm.expect(pm.response.json().data.type).to.eql(\"deposit\"));",
                  "pm.test(\"data.balance_after is 10000\", () => pm.expect(pm.response.json().data.balance_after).to.eql(10000));"
                ]
              }
            }
          ]
        },
