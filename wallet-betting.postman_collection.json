{
  "info": {
    "name": "Wallet & Betting API",
    "description": "Run top to bottom with a player who has no wallet. The final folder closes the wallet permanently, so each full run needs a new player_id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://pixelate-everything.test"
    },
    {
      "key": "player_id",
      "value": "1"
    },
    {
      "key": "deposit_reference",
      "value": ""
    },
    {
      "key": "won_bet_id",
      "value": ""
    },
    {
      "key": "lost_bet_id",
      "value": ""
    },
    {
      "key": "cancelled_bet_id",
      "value": ""
    },
    {
      "key": "pending_bet_id",
      "value": ""
    },
    {
      "key": "current_balance",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "1. Wallet",
