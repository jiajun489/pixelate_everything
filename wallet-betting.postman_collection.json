                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"deposit_reference\", pm.variables.replaceIn(\"dep-{{$guid}}\"));"
                ]
