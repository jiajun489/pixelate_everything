        {
          "name": "Create Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/players/{{player_id}}/wallet",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "players",
                "{{player_id}}",
                "wallet"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"data.balance is 0\", () => pm.expect(pm.response.json().data.balance).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Wallet",
